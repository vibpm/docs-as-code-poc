# Demo image: editable CMS + auto-rebuild + nginx (NOT production-hardened).
FROM node:22-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx \
    apache2-utils \
    ca-certificates \
    findutils \
    wget \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Default demo credentials (override at runtime)
ARG DEMO_USER=demo
ARG DEMO_PASSWORD=demo2026
RUN htpasswd -cb /etc/nginx/.htpasswd "$DEMO_USER" "$DEMO_PASSWORD"

RUN rm -f /etc/nginx/sites-enabled/default /etc/nginx/conf.d/default.conf || true
COPY deploy/demo/nginx.demo.conf /etc/nginx/conf.d/demo.conf
COPY deploy/demo/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
 && mkdir -p /var/cache/nginx /var/run \
 && CONTENT_AS_OF=2026-09-22 npm run build \
 && mkdir -p build/admin \
 && cp static/admin/index.html build/admin/index.html

ENV SITE_URL=http://localhost:8080
ENV CONTENT_BRANCH=master
ENV NODE_ENV=production

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health || exit 1

CMD ["/entrypoint.sh"]
