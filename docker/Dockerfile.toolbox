FROM node:22-alpine

RUN apk add --no-cache \
    bash \
    curl \
    git \
    jq \
    python3 \
    py3-pip

RUN npm install -g \
    markdownlint-cli2

RUN wget -O /usr/local/bin/vale \
    https://github.com/errata-ai/vale/releases/latest/download/vale_Linux_64-bit.tar.gz \
    || true

WORKDIR /workspace
