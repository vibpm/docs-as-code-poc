{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "content_type",
    "owner",
    "lifecycle",
    "valid_from",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+$"
    },
    "title": {
      "type": "string"
    },
    "content_type": {
      "const": "assembled_document"
    },
    "owner": {
      "type": "string"
    },
    "approver": {
      "type": "string"
    },
    "lifecycle": {
      "enum": [
        "draft",
        "approved",
        "effective",
        "retired"
      ]
    },
    "valid_from": {
      "type": "string"
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["heading"],
        "properties": {
          "heading": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "block_ref": {
            "type": "string"
          },
          "file_ref": {
            "type": "string",
            "pattern": "^content/"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
